{
  "name": "collabcanvas",
  "version": "1.0.0",
  "description": "Real-time multiplayer collaborative drawing, teaching, and room game platform",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite client",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build client --outDir ../dist",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.13.0",
    "nanoid": "^5.0.9",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "vite": "^6.1.1"
  },
  "keywords": [
    "whiteboard",
    "collaborative",
    "canvas",
    "realtime",
    "socketio",
    "games",
    "classroom"
  ],
  "author": "CollabCanvas Team",
  "license": "MIT"
}
